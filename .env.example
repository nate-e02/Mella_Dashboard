# PostgreSQL connection string (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://mellafx:mellafx_dev_password@localhost:5432/mellafx?schema=public"
# Secret used to sign session JWTs - change this in any non-local environment
JWT_SECRET="change_me_to_a_long_random_string"
SESSION_COOKIE_NAME="mellafx_session"

# Base URL of this app - used to build the Chapa callback_url/return_url
APP_URL="http://localhost:3000"

# Chapa payment provider (https://developer.chapa.co) - server-side only.
# Get these from your Chapa dashboard. NEVER commit real values here, and
# never expose the secret/encryption keys as NEXT_PUBLIC_* variables.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_MERCHANT_ID=
