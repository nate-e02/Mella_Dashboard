# PostgreSQL connection string (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://mellafx:mellafx_dev_password@localhost:5432/mellafx?schema=public"
# Secret used to sign session JWTs - change this in any non-local environment
JWT_SECRET="change_me_to_a_long_random_string"
SESSION_COOKIE_NAME="mellafx_session"

# Base URL of this app - used to build the Chapa callback_url/return_url
APP_URL="http://localhost:3000"

# Chapa payment provider (https://developer.chapa.co) - server-side only.
# Get these from your Chapa dashboard. NEVER commit real values here, and
# never expose the secret/encryption keys as NEXT_PUBLIC_* variables.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_MERCHANT_ID=

# Dojah KYC/identity provider (https://docs.dojah.io) - used for real KYC
# verification (Ethiopian Fayda ID). Get these from your Dojah dashboard.
# DOJAH_SECRET_KEY is server-side only (webhook signature verification) -
# NEVER commit it or expose it as a NEXT_PUBLIC_* variable. DOJAH_APP_ID and
# DOJAH_PUBLIC_KEY are returned to the authenticated trader's browser at
# runtime to launch Dojah's verification widget - this is Dojah's own
# documented, intended client-side use for these two values specifically.
# DOJAH_WIDGET_ID identifies the EasyOnboard verification flow configured
# in your Dojah dashboard (which country/ID type/steps it runs).
DOJAH_APP_ID=
DOJAH_PUBLIC_KEY=
DOJAH_SECRET_KEY=
DOJAH_WIDGET_ID=
