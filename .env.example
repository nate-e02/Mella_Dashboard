# ---------------------------------------------------------------------------
# MellaFx environment. Copy to .env for local development. Every value here is
# validated at boot (src/env.ts); production refuses to start with placeholders.
# ---------------------------------------------------------------------------

# PostgreSQL (docker-compose.yml starts one with these credentials)
DATABASE_URL="postgresql://mellafx:mellafx_dev_password@localhost:5432/mellafx?schema=public"

# Redis: rate limits across replicas + worker pub/sub. Optional locally
# (in-memory fallback), REQUIRED in production.
REDIS_URL="redis://localhost:6379"

# Session signing secret: at least 32 random characters. Generate with
#   openssl rand -base64 48
JWT_SECRET="change_me_to_a_long_random_string_at_least_32_chars"
SESSION_COOKIE_NAME="mellafx_session"
# Optional separate key for encrypting TOTP secrets at rest (defaults to JWT_SECRET)
# MFA_ENCRYPTION_KEY=

# Public base URL of the web app (https in production). Used for Chapa
# callback/return URLs, email links and CSRF origin checks.
APP_URL="http://localhost:3000"

# WebSocket endpoint of the trading worker as seen from the browser (read at
# runtime and handed to the browser with each ticket; use wss:// in production).
WS_PUBLIC_URL="ws://localhost:4100/ws"
# Internal URL + shared secret the web app uses to talk to the worker.
WORKER_INTERNAL_URL="http://localhost:4100"
WORKER_INTERNAL_TOKEN="change_me_worker_token"

# Admin two-factor: "true" forces every admin to enrol TOTP before using the
# admin console. Always enforced in production regardless of this value.
ADMIN_MFA_REQUIRED=false

# Development-only backdoors (KYC override, mark-paid, simulated trades).
# Ignored in production. Never set to true on a public deployment.
ENABLE_DEV_OVERRIDES=true

# ---- Chapa payments (https://developer.chapa.co) - server-side only ----
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_MERCHANT_ID=

# ---- Dojah KYC (https://docs.dojah.io) - fallback provider ----
DOJAH_APP_ID=
DOJAH_PUBLIC_KEY=
DOJAH_SECRET_KEY=
DOJAH_WIDGET_ID=

# ---- Notifications ----
# Transactional email via Resend (https://resend.com). Without these, emails
# (verification links, password resets) are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="MellaFx <no-reply@mellafx.com>"
# SMS gateway (GeezSMS / SMSEthiopia / 251SMS: any JSON POST {to, message})
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Telegram bot for trader notifications and an ops alert channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# ---- Seed script (development only) ----
# SEED_ADMIN_PASSWORD=
# SEED_TRADER_PASSWORD=

# ---------------------------------------------------------------------------
# Trading worker (npm run worker) - src/worker, src/trading. REDIS_URL,
# WORKER_INTERNAL_TOKEN and JWT_SECRET above are also read by the worker.
# ---------------------------------------------------------------------------
# HTTP port for /health, /status and /internal/*; the WebSocket gateway shares it at /ws
WORKER_PORT=4100
# Max concurrent WebSocket connections (default 10000)
WORKER_MAX_CONNECTIONS=10000
# Local development: force every instrument onto the SIMULATED stub feed.
# With ALLOW_BINANCE=true, crypto instruments keep using the real Binance public stream.
FEED_SOURCES_OVERRIDE=STUB
ALLOW_BINANCE=false
# Deterministic seed for the stub random walk (optional)
STUB_SEED=
# Create the default instrument catalogue on startup if rows are missing (idempotent, never overwrites)
SEED_DEFAULT_INSTRUMENTS=false
# cTrader Open API, JSON over WebSocket (port 5036; 5035 is protobuf). All four
# credentials are required or the CTRADER feed logs a warning and does not start.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
# ctidTraderAccountId of the (demo) account whose spot prices we subscribe to
CTRADER_ACCOUNT_ID=
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5036
# USD->ETB used ONLY when there is no FxRate row (base USD, quote ETB) and no
# SystemSetting fx.usd_etb {"rate": ...}; the worker warns loudly when it is used.
FX_USD_ETB_FALLBACK=125
# pino log level (trace|debug|info|warn|error); pretty output outside production unless LOG_PRETTY=false
LOG_LEVEL=info
