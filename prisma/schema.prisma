generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TRADER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TemplatePhase {
  PHASE_1
  PHASE_2
  FUNDED
}

enum ProgramType {
  STANDARD
  SWING_TRADER
  AGGRESSIVE
  INSTANT_FUNDING
  CONSISTENCY
  ELITE
  CRYPTO
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum AccountStatus {
  ACTIVE
  PASSED
  FAILED
  SUSPENDED
  FROZEN
  FUNDED
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

// ---------------------------------------------------------------------------
// Core / Auth
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(TRADER)
  status         UserStatus @default(ACTIVE)
  lastActivityAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions        Session[]
  purchases       Purchase[]
  tradingAccounts TradingAccount[]
  kycSubmissions  KycSubmission[]  @relation("KycOwner")
  kycReviewed     KycSubmission[]  @relation("KycReviewer")
  crmLead         CrmLead?
  supportTickets  SupportTicket[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  payouts         Payout[]

  @@index([role])
  @@index([status])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Templates (challenge products)
// ---------------------------------------------------------------------------

model Template {
  id          String         @id @default(cuid())
  name        String
  description String         @default("")
  price       Float          @default(0)
  currency    String         @default("USD")
  status      TemplateStatus @default(DRAFT)
  phase       TemplatePhase  @default(PHASE_1)
  programType ProgramType    @default(STANDARD)

  // grouping (e.g. "Standard", "Swing Trader") used to cluster phases of the
  // same program/account-size together in the admin UI
  groupName String
  groupKey  String

  // account configuration
  startingBalance Float  @default(10000)
  accountSize     Float  @default(10000)
  leverage        Int    @default(100)
  accountCurrency String @default("USD")

  // challenge rules
  profitTarget        Float?
  profitSplit         Int    @default(80)
  maxDrawdown         Float  @default(10)
  dailyDrawdown       Float  @default(5)
  minTradingDays      Int    @default(0)
  maxTradingDays      Int?
  maxPositionSize     Float?
  maxPositions        Int?
  durationDays        Int?
  passingRequirements String @default("")
  failingRequirements String @default("")

  // other rules
  weekendHoldingAllowed   Boolean @default(true)
  overnightHoldingAllowed Boolean @default(true)
  newsTradingAllowed      Boolean @default(true)
  stopLossRequired        Boolean @default(false)
  dailyLossResetTime      String  @default("00:00 UTC")
  consistencyRequirement  Float?

  // phase progression: points to the Template that a trader advances to
  nextPhaseId String?
  nextPhase   Template?  @relation("PhaseProgression", fields: [nextPhaseId], references: [id])
  previousOf  Template[] @relation("PhaseProgression")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  purchases       Purchase[]
  tradingAccounts TradingAccount[]

  @@index([status])
  @@index([groupKey])
}

// ---------------------------------------------------------------------------
// Purchases (demo payment) & Trading Accounts
// ---------------------------------------------------------------------------

model Purchase {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  templateId        String?
  template          Template?      @relation(fields: [templateId], references: [id])
  status            PurchaseStatus @default(PENDING)
  amount            Float
  currency          String         @default("USD")
  demoTransactionId String         @unique
  // Client-supplied key identifying one logical purchase attempt (e.g. one
  // click of "Pay"). Nullable so existing/seeded rows and any other
  // creation path without a key are unaffected; unique so a retried request
  // (double-click, network retry) with the same key can never create a
  // second Purchase/TradingAccount pair - see createDemoPurchase().
  idempotencyKey    String?        @unique
  paymentDate       DateTime?
  refundedAt        DateTime?
  cancelledAt       DateTime?
  // frozen copy of template config at time of purchase
  snapshot          Json

  tradingAccount TradingAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model TradingAccount {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  purchaseId String?   @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  previousAccountId String?         @unique
  previousAccount   TradingAccount? @relation("AccountProgression", fields: [previousAccountId], references: [id])
  nextAccount       TradingAccount? @relation("AccountProgression")

  // frozen challenge configuration (see Template for field meanings)
  snapshot Json

  phase  TemplatePhase @default(PHASE_1)
  status AccountStatus @default(ACTIVE)

  startingBalance    Float
  balance            Float
  equity             Float
  highWaterMark      Float
  dailyAnchorBalance Float
  dailyAnchorDate    DateTime @default(now())

  statusChangedAt DateTime  @default(now())
  passedAt        DateTime?
  failedAt        DateTime?
  fundedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades  Trade[]
  payouts Payout[]

  @@index([userId])
  @@index([status])
  @@index([templateId])
}

model Trade {
  id         String         @id @default(cuid())
  accountId  String
  account    TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol     String
  side       TradeSide
  volume     Float
  entryPrice Float
  exitPrice  Float?
  stopLoss   Float?
  takeProfit Float?
  openTime   DateTime
  closeTime  DateTime?
  profit     Float          @default(0)
  commission Float          @default(0)
  swap       Float          @default(0)
  netProfit  Float          @default(0)
  status     TradeStatus    @default(OPEN)
  createdAt  DateTime       @default(now())

  @@index([accountId])
  @@index([openTime])
}

// ---------------------------------------------------------------------------
// KYC
// ---------------------------------------------------------------------------

model KycSubmission {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("KycOwner", fields: [userId], references: [id])
  fullName     String
  country      String
  documentType String
  status       KycStatus @default(PENDING)
  notes        String    @default("")
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?     @relation("KycReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model CrmLead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  status    LeadStatus @default(NEW)
  source    String     @default("Website")
  value     Float      @default(0)
  notes     String     @default("")
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String
  response  String?
  status    TicketStatus @default(OPEN)
  priority  String       @default("normal")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Payout {
  id               String         @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  amount           Float
  status           PayoutStatus   @default(PENDING)
  requestedAt      DateTime       @default(now())
  paidAt           DateTime?

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType])
  @@index([createdAt])
}
